# The bot provisioner: the bot image plus the Docker CLI, because it creates bots by
# running lark-bots.sh against the host's Docker (docs/bot-provisioning-plan.md §3.2).
# Built by `./lark-bots.sh provisioner start` after `./lark-bots.sh build`.
FROM lark-bot:latest

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
 && echo "deb [signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
      > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
 && rm -rf /var/lib/apt/lists/*

# Runs as the host user that owns the lark-bots folder (see provisioner.yaml).
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["lark-channel-bridge", "provisioner"]
