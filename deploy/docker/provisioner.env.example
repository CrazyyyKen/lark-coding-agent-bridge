# Copy to provisioner.env (mode 600) and fill in. Never commit provisioner.env.
# docs/bot-provisioning-plan.md §3.2; deploy/docker/README.md, "The bot provisioner".

# The provisioner's own Lark app ("AI Agent Admin"): a custom app with Bot enabled,
# events and callbacks on persistent connection, card.action.trigger subscribed.
# It must be a member of the approval group and a collaborator (can edit) on the Base.
PROVISIONER_APP_ID=cli_xxxxxxxxxxxxxxxx
PROVISIONER_APP_SECRET=

# The "AI Agent Requests" Base (the token in its URL: .../base/<token>)
PROVISIONER_BASE_TOKEN=Ej2rbuVelaxD7xsLa4EllBP6gph

# Group that gets the approval cards; every member may approve or reject
PROVISIONER_CHAT_ID=oc_f803a6d76d71872a15dbba9a5a92fda0

# lark (larksuite.com) or feishu
PROVISIONER_TENANT=lark

# How often to look for new form submissions, in seconds (at least 15)
PROVISIONER_POLL_SECONDS=60
