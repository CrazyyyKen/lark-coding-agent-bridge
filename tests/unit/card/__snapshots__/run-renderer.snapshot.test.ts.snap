          },
          "icon_expanded_angle": -180,
          "icon_position": "follow_text",
          "title": {
            "content": "☕ **2 tool calls**",
            "tag": "markdown",
          },
          "vertical_align": "center",
        },
        "padding": "8px 8px 8px 8px",
        "tag": "collapsible_panel",
        "vertical_spacing": "8px",
      },
      {
        "border": {
          "color": "grey",
          "corner_radius": "5px",
        },
        "elements": [
          {
            "content": "**File** \`/repo/a.ts\`

_Running…_",
            "tag": "markdown",
            "text_size": "notation",
          },
        ],
        "expanded": true,
        "header": {
          "icon": {
            "size": "16px 16px",
            "tag": "standard_icon",
            "token": "down-small-ccm_outlined",
          },
          "icon_expanded_angle": -180,
          "icon_position": "follow_text",
          "title": {
            "content": "⏳ **Edit** — /repo/a.ts",
            "tag": "markdown",
          },
          "vertical_align": "center",
        },
        "padding": "8px 8px 8px 8px",
        "tag": "collapsible_panel",
        "vertical_spacing": "8px",
      },
      {
        "content": "🧰 Calling tools",
        "tag": "markdown",
        "text_size": "notation",
      },
      {
        "behaviors": [
          {
            "type": "callback",
            "value": {
              "cmd": "stop",
            },
          },
        ],
        "tag": "button",
        "text": {
          "content": "⏹ Stop",
          "tag": "plain_text",
        },
        "type": "danger",
      },
    ],
  },
  "config": {
    "streaming_mode": true,
    "summary": {
      "content": "Calling tools",
    },
  },
  "schema": "2.0",
}
`;

